---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import TutorialCard from '../../../components/tutorial/TutorialCard.astro';
import Icon from '../../../components/ui/Icon.astro';
import { PUBLISHED_LOCALES, type Locale } from '../../../config/locales';
import { t } from '../../../config/translations';
import { routes } from '../../../lib/routes';
import { listLessons, listTutorials } from '../../../lib/tutorials';

export function getStaticPaths() {
  return PUBLISHED_LOCALES.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const dict = t(locale);
const tutorials = await listTutorials(locale);
const lessonSets = await Promise.all(
  tutorials.map((tutorial) => listLessons(tutorial.data.key, locale)),
);
const es = locale === 'es';
---

<BaseLayout
  locale={locale}
  title={dict.allTutorials}
  description={es
    ? 'Guías prácticas para aprender a utilizar PM Amco Editorial sin complicaciones.'
    : 'Practical, easy-to-follow PM Amco Editorial tutorials.'}
  path={routes.tutorials(locale)}
>
  <section class="catalog-header">
    <div class="container">
      <nav class="breadcrumb breadcrumb--light" aria-label="Breadcrumb">
        <a href={routes.home(locale)}>{dict.breadcrumbHome}</a><span>/</span><span
          aria-current="page">{dict.navTutorials}</span
        >
      </nav><div class="catalog-header__split">
        <div>
          <span class="eyebrow eyebrow--light"
            >{es ? 'BIBLIOTECA DE APRENDIZAJE' : 'LEARNING LIBRARY'}</span
          ><h1>{es ? 'Tu siguiente habilidad empieza aquí.' : 'Your next skill starts here.'}</h1><p
          >
            {
              es
                ? 'Elige lo que necesitas aprender hoy. Cada guía está pensada para que avances con seguridad.'
                : 'Choose what you want to learn today, with clear steps and helpful examples.'
            }
          </p>
        </div><span class="catalog-header__number" aria-hidden="true"
          >{String(tutorials.length).padStart(2, '0')}<small>{es ? 'GUÍAS' : 'GUIDES'}</small></span
        >
      </div>
    </div>
  </section>
  <section class="section-pad">
    <div class="container">
      <div class="section-heading section-heading--compact">
        <div>
          <span class="eyebrow eyebrow--ink">{es ? 'EXPLORA' : 'EXPLORE'}</span><h2>
            {es ? 'Todas las guías' : 'All guides'}
          </h2>
        </div><div class="catalog-count">
          <Icon name="layers" size={17} />{tutorials.length}
          {es ? 'disponible(s)' : 'available'}
        </div>
      </div><div class="tutorial-grid">
        {
          tutorials.map((tutorial, index) => (
            <TutorialCard
              tutorial={tutorial}
              lessons={lessonSets[index] ?? []}
              locale={locale}
              number={index + 1}
            />
          ))
        }
      </div>{tutorials.length === 0 && <p class="empty-state">{dict.noTutorials}</p>}
    </div>
  </section>
</BaseLayout>
