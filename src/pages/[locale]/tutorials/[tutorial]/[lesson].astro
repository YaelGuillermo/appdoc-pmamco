---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import LessonSidebar from '../../../../components/tutorial/LessonSidebar.astro';
import Screenshot from '../../../../components/tutorial/Screenshot.astro';
import StepPager from '../../../../components/tutorial/StepPager.astro';
import KnowledgeCheck from '../../../../components/tutorial/KnowledgeCheck.astro';
import Icon from '../../../../components/ui/Icon.astro';
import { PUBLISHED_LOCALES, type Locale } from '../../../../config/locales';
import { t } from '../../../../config/translations';
import { routes } from '../../../../lib/routes';
import { listLessons, findTutorial, chapterTitle } from '../../../../lib/tutorials';

export async function getStaticPaths() {
  const tutorials = await getCollection(
    'tutorials',
    (entry) => entry.data.published && PUBLISHED_LOCALES.includes(entry.data.locale),
  );
  const paths: { params: { locale: string; tutorial: string; lesson: string } }[] = [];
  for (const tutorial of tutorials) {
    const lessons = await listLessons(tutorial.data.key, tutorial.data.locale);
    for (const lesson of lessons)
      paths.push({
        params: {
          locale: tutorial.data.locale,
          tutorial: tutorial.data.slug,
          lesson: lesson.data.slug,
        },
      });
  }
  return paths;
}
const locale = Astro.params.locale as Locale;
const tutorialSlug = Astro.params.tutorial ?? '';
const lessonSlug = Astro.params.lesson ?? '';
const tutorial = await findTutorial(locale, tutorialSlug);
if (!tutorial) throw new Error(`Published tutorial missing: ${locale}/${tutorialSlug}`);
const lessons = await listLessons(tutorial.data.key, locale);
const stepIndex = lessons.findIndex((item) => item.data.slug === lessonSlug);
const lesson = lessons[stepIndex];
if (!lesson) throw new Error(`Lesson missing: ${locale}/${tutorialSlug}/${lessonSlug}`);
const { Content } = await render(lesson);
const previous = stepIndex > 0 ? lessons[stepIndex - 1] : undefined;
const next = stepIndex < lessons.length - 1 ? lessons[stepIndex + 1] : undefined;
const dict = t(locale);
const es = locale === 'es';
const stepPath = routes.lesson(locale, tutorialSlug, lessonSlug);
const stepList = JSON.stringify(lessons.map((item) => item.data.slug));
---

<BaseLayout
  locale={locale}
  title={lesson.data.title}
  description={lesson.data.description}
  path={stepPath}
>
  <div class="lesson-frame">
    <div
      class="container lesson-frame__inner"
      data-progress-root
      data-tutorial-key={tutorial.data.key}
      data-locale={locale}
      data-step-list={stepList}
      data-step-url-base={routes.tutorial(locale, tutorialSlug)}
    >
      <LessonSidebar
        locale={locale}
        tutorial={tutorial}
        lessons={lessons}
        currentSlug={lessonSlug}
      />
      <article class="lesson-content">
        <nav class="breadcrumb breadcrumb--ink" aria-label="Breadcrumb">
          <a href={routes.home(locale)}>{dict.breadcrumbHome}</a><span>/</span><a
            href={routes.tutorials(locale)}>{dict.navTutorials}</a
          ><span>/</span><a href={routes.tutorial(locale, tutorialSlug)}
            >{es ? 'Tu recorrido' : 'Your learning path'}</a
          >
        </nav>
        <div class="lesson-content__header">
          <div class="lesson-content__section">
            <span class="section-pin"></span>{chapterTitle(lesson.data.section, locale)}<span
              class="lesson-content__section-dot">·</span
            >{dict.stepOf}
            {String(lesson.data.order).padStart(2, '0')} / {String(lessons.length).padStart(2, '0')}
          </div><h1>{lesson.data.title}</h1><p class="lesson-content__dek">
            {lesson.data.description}
          </p><div class="lesson-content__time">
            <Icon name="clock" size={16} />{lesson.data.estimatedMinutes}
            {dict.minutes}
          </div>
        </div>
        <div class="lesson-prose prose"><Content /></div>
        {
          lesson.data.screenshots.map((image) => (
            <Screenshot file={image.file} alt={image.alt} caption={image.caption} locale={locale} />
          ))
        }
        {
          lesson.data.note && (
            <aside class="lesson-note">
              <>
                <div class="lesson-note__symbol">
                  <Icon name="shield" size={21} />
                </div>
                <div>
                  <>
                    <strong>{dict.helpfulReminder}</strong>
                    <p>{lesson.data.note}</p>
                  </>
                </div>
              </>
            </aside>
          )
        }
        {lesson.data.interaction === 'quiz' && <KnowledgeCheck locale={locale} />}
        <div class="lesson-complete">
          <div>
            <span class="eyebrow eyebrow--ink">{es ? 'IDEA CLAVE' : 'KEY TAKEAWAY'}</span><p>
              {lesson.data.takeaway}
            </p>
          </div><button
            type="button"
            class="learned-button"
            data-progress-toggle
            data-step-id={lesson.data.slug}
            data-undone-label={dict.completeStep}
            data-done-label={dict.completedStep}
            aria-pressed="false"
            ><span class="learned-button__check"><Icon name="check" size={18} /></span><span
              data-progress-toggle-label>{dict.completeStep}</span
            ></button
          >
        </div>
        <StepPager locale={locale} tutorial={tutorial} previous={previous} next={next} />
      </article>
      <aside class="lesson-aside">
        <div class="lesson-aside__sticky">
          <div class="lesson-aside__card">
            <span class="eyebrow eyebrow--ink">{dict.onThisStep}</span><div
              class="lesson-aside__number"
            >
              {String(lesson.data.order).padStart(2, '0')}<span
                >/{String(lessons.length).padStart(2, '0')}</span
              >
            </div><div class="lesson-aside__divider"></div><p>{lesson.data.takeaway}</p>
          </div><div class="lesson-aside__helper">
            <Icon name="book-open" size={19} /><p>
              {
                es
                  ? 'Avanza a tu ritmo. Puedes volver a cualquier paso cuando quieras.'
                  : 'Go at your pace. You can revisit any step.'
              }
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
