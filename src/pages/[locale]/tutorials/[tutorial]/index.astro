---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import LearningIndex from '../../../../components/tutorial/LearningIndex.astro';
import ClockDemo from '../../../../components/tutorial/ClockDemo.astro';
import Icon from '../../../../components/ui/Icon.astro';
import { PUBLISHED_LOCALES, type Locale } from '../../../../config/locales';
import { t } from '../../../../config/translations';
import { routes } from '../../../../lib/routes';
import { listLessons, findTutorial } from '../../../../lib/tutorials';
import { absoluteUrl, howToStructuredData } from '../../../../lib/seo';

export async function getStaticPaths() {
  const tutorials = await getCollection(
    'tutorials',
    (entry) => entry.data.published && PUBLISHED_LOCALES.includes(entry.data.locale),
  );
  return tutorials.map((tutorial) => ({
    params: { locale: tutorial.data.locale, tutorial: tutorial.data.slug },
  }));
}
const locale = Astro.params.locale as Locale;
const slug = Astro.params.tutorial ?? '';
const tutorial = await findTutorial(locale, slug);
if (!tutorial) throw new Error(`Published tutorial missing: ${locale}/${slug}`);
const lessons = await listLessons(tutorial.data.key, locale);
const { Content } = await render(tutorial);
const dict = t(locale);
const es = locale === 'es';
const path = routes.tutorial(locale, tutorial.data.slug);
const first = lessons[0];
const structuredData = howToStructuredData({
  title: tutorial.data.title,
  description: tutorial.data.description,
  locale,
  url: absoluteUrl(path, Astro.site ?? new URL('https://amco.me/')),
  steps: lessons.map((lesson) => ({
    title: lesson.data.title,
    url: absoluteUrl(
      routes.lesson(locale, slug, lesson.data.slug),
      Astro.site ?? new URL('https://amco.me/'),
    ),
  })),
});
---

<BaseLayout
  locale={locale}
  title={tutorial.data.title}
  description={tutorial.data.description}
  path={path}
  structuredData={structuredData}
>
  <section
    class="guide-hero"
    data-progress-root
    data-tutorial-key={tutorial.data.key}
    data-locale={locale}
    data-step-list={JSON.stringify(lessons.map((lesson) => lesson.data.slug))}
    data-step-url-base={path}
  >
    <div class="container">
      <nav class="breadcrumb breadcrumb--light" aria-label="Breadcrumb">
        <a href={routes.home(locale)}>{dict.breadcrumbHome}</a><span>/</span><a
          href={routes.tutorials(locale)}>{dict.navTutorials}</a
        ><span>/</span><span aria-current="page">{es ? 'Registrar tiempo' : 'Track time'}</span>
      </nav>
      <div class="guide-hero__grid">
        <div class="guide-hero__copy">
          <span class="eyebrow eyebrow--light"
            ><span class="eyebrow__pin"></span>{
              es ? 'TUTORIAL · PRIMEROS PASOS' : 'TUTORIAL · GETTING STARTED'
            }</span
          ><h1>{tutorial.data.title}</h1><p>{tutorial.data.description}</p><div
            class="guide-hero__meta"
          >
            <span
              ><Icon name="clock" size={18} />{tutorial.data.estimatedMinutes} {dict.minutes}</span
            ><span><Icon name="layers" size={18} />{lessons.length} {dict.chapters}</span><span
              ><Icon name="shield" size={18} />{es ? 'Nivel inicial' : 'Beginner'}</span
            >
          </div>{
            first && (
              <a
                class="button button--cream"
                href={routes.lesson(locale, tutorial.data.slug, first.data.slug)}
                data-continue-link
                data-continue-text={dict.continueLearning}
              >
                <>
                  <span data-continue-label>{dict.startTutorial}</span>
                  <Icon name="arrow-right" size={18} />
                </>
              </a>
            )
          }
        </div>
        <div class="guide-hero__visual" aria-hidden="true">
          <div class="guide-clock">
            <div class="guide-clock__inner">
              <div class="guide-clock__hand guide-clock__hand--long"></div><div
                class="guide-clock__hand guide-clock__hand--short"
              >
              </div><span class="guide-clock__dot"></span><span
                class="guide-clock__tick guide-clock__tick--twelve"></span><span
                class="guide-clock__tick guide-clock__tick--three"></span><span
                class="guide-clock__tick guide-clock__tick--six"></span><span
                class="guide-clock__tick guide-clock__tick--nine"></span>
            </div>
          </div><div class="guide-hero__floating guide-hero__floating--a">
            <Icon name="play" size={19} /> 10:00 · {es ? 'Comenzar' : 'Start'}
          </div><div class="guide-hero__floating guide-hero__floating--b">
            <Icon name="check" size={19} /> 13:00 · {es ? 'Finalizar' : 'Finish'}
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="guide-intro">
    <div class="container guide-intro__columns">
      <div>
        <span class="eyebrow eyebrow--ink"
          >{es ? 'LO QUE VAS A LOGRAR' : 'WHAT YOU WILL LEARN'}</span
        ><h2>
          {
            es
              ? 'Aprende lo útil. Quédate con lo importante.'
              : 'Learn what matters. Keep it simple.'
          }
        </h2><div class="prose prose--intro"><Content /></div>
      </div><div class="outcome-panel">
        <div class="outcome-panel__top"><Icon name="sparkles" size={19} />{dict.whatYouLearn}</div>{
          tutorial.data.outcomes.map((outcome, index) => (
            <div class="outcome-panel__item">
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{outcome}</p>
                <Icon name="check" size={17} />
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <div class="container">
    <LearningIndex locale={locale} tutorial={tutorial} lessons={lessons} />
  </div>
  <div class="container"><ClockDemo locale={locale} /></div>
</BaseLayout>
