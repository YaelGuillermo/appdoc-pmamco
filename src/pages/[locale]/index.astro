---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import TutorialCard from '../../components/tutorial/TutorialCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { PUBLISHED_LOCALES, type Locale } from '../../config/locales';
import { routes } from '../../lib/routes';
import { getCatalog } from '../../lib/catalog';

export function getStaticPaths() {
  return PUBLISHED_LOCALES.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const es = locale === 'es';
const app = (await getCatalog(locale)).find(
  ({ platform }) => platform.data.key === 'pm-amco-editorial',
);
if (!app) throw new Error(`No existe PM Amco Editorial publicado en ${locale}`);
const { platform, tutorials } = app;
---

<BaseLayout
  locale={locale}
  title={es ? 'Aprende a tu ritmo' : 'Learn at your own pace'}
  description={es
    ? 'Amco Experience: tutoriales de bienvenida y registro de tiempo para aprender PM Amco Editorial paso a paso.'
    : 'Amco Experience: practical PM Amco Editorial tutorials, one step at a time.'}
  path={routes.home(locale)}
>
  <HomeHero locale={locale} tutorials={tutorials} />
  <section class="intro-strip" id="como-funciona">
    <div class="container intro-strip__inner">
      <div class="intro-strip__eyebrow">
        <Icon name="sparkles" size={17} />
        {es ? 'APRENDE SIN COMPLICACIONES' : 'LEARNING MADE SIMPLE'}
      </div>
      <div class="intro-strip__features">
        <span><b>01</b>{es ? 'Elige un tutorial' : 'Choose a tutorial'}</span>
        <span><b>02</b>{es ? 'Sigue cada paso' : 'Follow each step'}</span>
        <span><b>03</b>{es ? 'Practica a tu ritmo' : 'Practice at your pace'}</span>
      </div>
    </div>
  </section>
  <section class="featured-section section-pad" id="tutoriales">
    <div class="container">
      <div class="experience-app-heading" id={platform.data.slug}>
        <div class="experience-app-heading__monogram" aria-hidden="true">
          {platform.data.monogram}
        </div>
        <div class="experience-app-heading__copy">
          <span class="eyebrow eyebrow--ink"
            >{es ? 'SOLUCIÓN · GESTIÓN EDITORIAL' : 'SOLUTION · EDITORIAL WORK'}</span
          >
          <h2>{platform.data.title}</h2>
          <p>{platform.data.description}</p>
        </div>
        <div class="catalog-count">
          <Icon name="book-open" size={17} />{tutorials.length}
          {es ? 'tutoriales' : 'tutorials'}
        </div>
      </div>
      <div class="section-heading section-heading--compact">
        <div>
          <span class="eyebrow eyebrow--ink"
            >{es ? 'TU PUNTO DE PARTIDA' : 'YOUR STARTING POINT'}</span
          >
          <h2>{es ? 'Empieza por aquí.' : 'Start here.'}</h2>
          <p>
            {
              es
                ? 'Primero conoce tu espacio de trabajo; después aprende a registrar tus horas.'
                : 'Discover your workspace first, then learn how to track time.'
            }
          </p>
        </div>
      </div>
      <div class="tutorial-grid">
        {
          tutorials.map(({ tutorial, lessons }, index) => (
            <TutorialCard
              platform={platform}
              tutorial={tutorial}
              lessons={lessons}
              locale={locale}
              number={index + 1}
            />
          ))
        }
      </div>
    </div>
  </section>
  <section class="promise-section">
    <div class="container promise-grid">
      <div class="promise-grid__statement">
        <span class="eyebrow eyebrow--ink"
          >{es ? 'NUESTRA FORMA DE ENSEÑAR' : 'OUR LEARNING APPROACH'}</span
        >
        <h2>
          {es ? 'Menos teoría.' : 'Less theory.'}<br /><em
            >{es ? 'Más saber hacer.' : 'More doing.'}</em
          >
        </h2>
      </div>
      <div class="promise-grid__details">
        <div>
          <span class="promise-grid__icon"><Icon name="book-open" size={21} /></span>
          <h3>{es ? 'Guías prácticas' : 'Practical guides'}</h3>
          <p>
            {
              es
                ? 'Encuentra lo esencial de PM Amco Editorial sin menús ni catálogos innecesarios.'
                : 'Learn the essentials without unnecessary navigation.'
            }
          </p>
        </div>
        <div>
          <span class="promise-grid__icon"><Icon name="check-circle" size={21} /></span>
          <h3>{es ? 'Aprende haciendo' : 'Learn by doing'}</h3>
          <p>
            {
              es
                ? 'Cada tutorial te acompaña en una acción concreta y guarda tu avance.'
                : 'Each tutorial guides a meaningful action and saves your progress.'
            }
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
