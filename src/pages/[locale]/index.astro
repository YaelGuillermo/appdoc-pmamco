---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import TutorialCard from '../../components/tutorial/TutorialCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { PUBLISHED_LOCALES, type Locale } from '../../config/locales';
import { t } from '../../config/translations';
import { routes } from '../../lib/routes';
import { listLessons, listTutorials } from '../../lib/tutorials';

export function getStaticPaths() {
  return PUBLISHED_LOCALES.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const dict = t(locale);
const tutorials = await listTutorials(locale);
const lessonsByTutorial = await Promise.all(
  tutorials.map((tutorial) => listLessons(tutorial.data.key, locale)),
);
const es = locale === 'es';
---

<BaseLayout
  locale={locale}
  title={es ? 'Aprende a tu ritmo' : 'Learn at your own pace'}
  description={es
    ? 'Tutoriales visuales de PM Amco Editorial, con pasos claros y ejemplos cotidianos.'
    : 'Practical PM Amco Editorial tutorials, step by step.'}
  path={routes.home(locale)}
>
  <HomeHero locale={locale} />
  <section class="intro-strip" id="como-funciona">
    <div class="container intro-strip__inner">
      <div class="intro-strip__eyebrow">
        <Icon name="sparkles" size={17} />{
          es ? 'APRENDE SIN COMPLICACIONES' : 'LEARNING MADE SIMPLE'
        }
      </div><div class="intro-strip__features">
        <span><b>01</b>{es ? 'Elige una guía' : 'Pick a guide'}</span><span
          ><b>02</b>{es ? 'Sigue cada paso' : 'Follow the steps'}</span
        ><span><b>03</b>{es ? 'Practica a tu ritmo' : 'Learn at your pace'}</span>
      </div>
    </div>
  </section>
  <section class="featured-section section-pad" id="tutoriales">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow eyebrow--ink"
            >{es ? 'TUTORIALES DISPONIBLES' : 'AVAILABLE TUTORIALS'}</span
          ><h2>{es ? 'Empieza por aquí.' : 'Start here.'}</h2><p>
            {
              es
                ? 'Un recorrido sencillo para dominar lo esencial de la plataforma.'
                : 'A simple path to learn the essentials.'
            }
          </p>
        </div><a class="section-heading__link" href={routes.tutorials(locale)}
          >{dict.allTutorials}<Icon name="arrow-right" size={18} /></a
        >
      </div>
      <div class="tutorial-grid">
        {
          tutorials.map((tutorial, index) => (
            <TutorialCard
              tutorial={tutorial}
              lessons={lessonsByTutorial[index] ?? []}
              locale={locale}
              number={index + 1}
            />
          ))
        }
      </div>
      {tutorials.length === 0 && <p class="empty-state">{dict.noTutorials}</p>}
    </div>
  </section>
  <section class="promise-section">
    <div class="container promise-grid">
      <div class="promise-grid__statement">
        <span class="eyebrow eyebrow--ink"
          >{es ? 'NUESTRA FORMA DE ENSEÑAR' : 'OUR LEARNING APPROACH'}</span
        ><h2>
          {es ? 'Menos teoría.' : 'Less theory.'}<br /><em
            >{es ? 'Más saber hacer.' : 'More doing.'}</em
          >
        </h2>
      </div><div class="promise-grid__details">
        <div>
          <span class="promise-grid__icon"><Icon name="book-open" size={21} /></span><h3>
            {es ? 'Pensado para personas' : 'Made for people'}
          </h3><p>
            {
              es
                ? 'Explicaciones cotidianas, sin términos que tengas que descifrar.'
                : 'Everyday explanations without jargon.'
            }
          </p>
        </div><div>
          <span class="promise-grid__icon"><Icon name="check-circle" size={21} /></span><h3>
            {es ? 'Aprende haciendo' : 'Learn by doing'}
          </h3><p>
            {
              es
                ? 'Cada tutorial te acompaña en una acción concreta de PM Amco.'
                : 'Every tutorial guides one meaningful action.'
            }
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
