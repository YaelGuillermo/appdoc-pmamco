---
import type { Locale } from '../../config/locales';
import type { TutorialGroup } from '../../lib/catalog';
import { routes } from '../../lib/routes';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
  tutorials: readonly TutorialGroup[];
}
const { locale, tutorials } = Astro.props;
const es = locale === 'es';
---

<section class="home-hero">
  <div class="home-hero__grid" aria-hidden="true"></div>
  <div class="container home-hero__layout">
    <div class="home-hero__copy">
      <span class="eyebrow eyebrow--light">
        <span class="eyebrow__pin"></span>
        {es ? 'TU ESPACIO DE APRENDIZAJE AMCO' : 'YOUR AMCO LEARNING SPACE'}
      </span>
      <h1>
        {es ? 'Todo un mundo' : 'A whole world'}
        <span>{es ? 'por descubrir.' : 'to discover.'}</span>
      </h1>
      <p>
        {
          es
            ? 'Bienvenido a Amco Experience. Conoce PM Amco Editorial a través de tutoriales visuales, claros y prácticos. Empieza por lo esencial y aprende a tu ritmo.'
            : 'Welcome to Amco Experience. Discover PM Amco Editorial through clear, visual tutorials, from the essentials onward.'
        }
      </p>
      <div class="hero-buttons">
        <a class="button button--cream" href={routes.tutorials(locale)}>
          {es ? 'Ver tutoriales' : 'Explore tutorials'}
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="text-link text-link--light" href="#como-funciona">
          {es ? '¿Cómo funciona?' : 'How does it work?'}<span>↘</span>
        </a>
      </div>
      <div class="hero-signature">
        <span class="signature-dash"></span>
        {es ? 'UNA NUEVA HABILIDAD A LA VEZ' : 'ONE NEW SKILL AT A TIME'}
      </div>
    </div>
    <div class="home-hero__art" aria-hidden="true">
      <div class="art-orbit art-orbit--one"></div>
      <div class="art-orbit art-orbit--two"></div>
      <div class="art-stamp">AMCO / <span>EXPERIENCE</span></div>
      <div class="art-card">
        <div class="art-card__top">
          <span class="art-card__dots"><i></i><i></i><i></i></span>
          <span>AMCO EXPERIENCE · PM AMCO EDITORIAL</span>
        </div>
        <div class="art-card__content">
          <div class="art-caption">{es ? 'Tu ruta de aprendizaje' : 'Your learning path'}</div>
          <strong>{es ? 'Empieza por lo esencial.' : 'Start with the essentials.'}</strong>
          <p>{es ? 'Dos guías, a tu ritmo.' : 'Two guides, at your pace.'}</p>
          <div class="experience-preview">
            {
              tutorials.map(({ tutorial, lessons }, index) => (
                <div class="experience-preview__item">
                  <span
                    class:list={[
                      'experience-preview__glyph',
                      index === 0
                        ? 'experience-preview__glyph--sand'
                        : 'experience-preview__glyph--sage',
                    ]}
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span>
                    <b>{tutorial.data.title}</b>
                    <small>
                      {lessons.length} {es ? 'pasos' : 'steps'}
                    </small>
                  </span>
                  <Icon name="arrow-right" size={17} />
                </div>
              ))
            }
          </div>
        </div>
        <div class="art-card__bottom">
          <span><Icon name="sparkles" size={15} /> AMCO EXPERIENCE</span>
          <span>01 / 02</span>
        </div>
      </div>
      <div class="art-float">
        <span class="art-float__icon"><Icon name="sparkles" size={17} /></span>
        <span>{es ? 'Aprende a tu manera.' : 'Learn your way.'}</span>
      </div>
    </div>
  </div>
</section>
