---
import { LANGUAGE_NAMES, LOCALES, PUBLISHED_LOCALES, type Locale } from '../../config/locales';
import { t } from '../../config/translations';
import { routes } from '../../lib/routes';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href={routes.home(locale)} aria-label="PM Amco Editorial — inicio">
      <span class="brand__glyph" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand__type"><strong>PM AMCO</strong><small><span></span> EDITORIAL</small></span
      >
    </a>
    <nav class="main-nav" aria-label="Navegación principal">
      <a href={routes.home(locale)}>{dict.navHome}</a>
      <a href={routes.tutorials(locale)}>{dict.navTutorials}</a>
    </nav>
    <div class="header-actions">
      {
        PUBLISHED_LOCALES.length > 1 && (
          <details class="locale-picker">
            <summary aria-label={dict.language}>
              <>
                <Icon name="globe" size={17} />
                <span>{locale.toUpperCase()}</span>
                <Icon name="chevron-down" size={14} />
              </>
            </summary>
            <div class="locale-picker__menu">
              {LOCALES.map((availableLocale) =>
                PUBLISHED_LOCALES.includes(availableLocale) ? (
                  <a
                    href={routes.home(availableLocale)}
                    aria-current={availableLocale === locale ? 'true' : undefined}
                  >
                    <span>{LANGUAGE_NAMES[availableLocale]}</span>
                    <small>{dict.publishedLabel}</small>
                  </a>
                ) : (
                  <span class="locale-picker__disabled">
                    <span>{LANGUAGE_NAMES[availableLocale]}</span>
                    <small>{dict.comingSoon}</small>
                  </span>
                ),
              )}
            </div>
          </details>
        )
      }
      <a class="header-cta" href={routes.tutorials(locale)}
        >{dict.navStart}<Icon name="arrow-right" size={16} /></a
      >
    </div>
  </div>
</header>
