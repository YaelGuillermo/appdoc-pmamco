---
import type { Locale } from '../../config/locales';
import { routes } from '../../lib/routes';
import { t } from '../../config/translations';
import Icon from '../ui/Icon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <a class="brand brand--footer" href={routes.home(locale)}
        ><span class="brand__glyph" aria-hidden="true"><i></i><i></i><i></i></span><span
          class="brand__type"><strong>PM AMCO</strong><small>ACADEMY · EDITORIAL</small></span
        ></a
      >
      <p>{dict.footerCaption}</p>
    </div>
    <div class="footer-links">
      <a href={routes.home(locale)}>{dict.navHome}</a>
      <a href={routes.tutorials(locale)}
        >{dict.navTutorials} <Icon name="arrow-right" size={14} /></a
      >
    </div>
  </div>
  <div class="footer-bottom container">
    <span>© {new Date().getFullYear()} PM Amco Editorial</span><span>{dict.allRights}</span>
  </div>
</footer>
