---
import type { Locale } from '../../config/locales';
import { t } from '../../config/translations';
import type { Tutorial, Lesson } from '../../lib/tutorials';
import { routes } from '../../lib/routes';
import Icon from '../ui/Icon.astro';
interface Props {
  tutorial: Tutorial;
  lessons: Lesson[];
  locale: Locale;
  number?: number;
}
const { tutorial, lessons, locale, number = 1 } = Astro.props;
const dict = t(locale);
const slug = tutorial.data.slug;
const path = routes.tutorial(locale, slug);
const hrefFirst = lessons[0] ? routes.lesson(locale, slug, lessons[0].data.slug) : path;
const serializedSteps = JSON.stringify(lessons.map((lesson) => lesson.data.slug));
---

<article
  class="tutorial-card"
  data-progress-root
  data-tutorial-key={tutorial.data.key}
  data-locale={locale}
  data-step-list={serializedSteps}
  data-step-url-base={path}
>
  <div class="tutorial-card__visual">
    <div class="tutorial-card__corner-number">{String(number).padStart(2, '0')}</div>
    <div class="card-illustration" aria-hidden="true">
      <div class="card-illustration__clock">
        <span class="clock-hand clock-hand--one"></span><span class="clock-hand clock-hand--two"
        ></span><span class="clock-dot"></span>
      </div><div class="card-illustration__tick card-illustration__tick--first">
        <Icon name="check" size={17} />
      </div><div class="card-illustration__tick card-illustration__tick--second">
        <Icon name="pause" size={15} />
      </div><div class="card-illustration__spark"></div>
    </div>
    <div class="tutorial-card__visual-footer">
      <span>PM AMCO Editorial / GUIDE</span><span
        >{String(number).padStart(2, '0')} — {String(lessons.length).padStart(2, '0')}</span
      >
    </div>
  </div>
  <div class="tutorial-card__body">
    <div class="small-meta">
      <span
        ><Icon name="book-open" size={15} />{
          locale === 'es' ? 'GUÍA PRÁCTICA' : 'PRACTICAL GUIDE'
        }</span
      ><span>{tutorial.data.estimatedMinutes} {dict.minutes}</span>
    </div>
    <h3><a href={path}>{tutorial.data.title}</a></h3><p>{tutorial.data.description}</p>
    <div class="tutorial-card__progress">
      <div class="tutorial-card__progress-track">
        <div data-progress-fill style="width: 0%"></div>
      </div><span data-progress-count>0 / {lessons.length}</span>
    </div>
    <a
      class="tutorial-card__link"
      href={hrefFirst}
      data-continue-link
      data-continue-text={dict.continueLearning}
      ><span data-continue-label>{dict.startTutorial}</span><span class="tutorial-card__link-icon"
        ><Icon name="arrow-right" size={20} /></span
      ></a
    >
  </div>
</article>
