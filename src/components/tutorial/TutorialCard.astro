---
import type { Locale } from '../../config/locales';
import { t } from '../../config/translations';
import type { Platform, Tutorial, Lesson } from '../../lib/catalog';
import { tutorialProgressKey } from '../../lib/catalog';
import { routes } from '../../lib/routes';
import Icon from '../ui/Icon.astro';

interface Props {
  tutorial: Tutorial;
  lessons: readonly Lesson[];
  locale: Locale;
  platform: Platform;
  number?: number;
}
const { tutorial, lessons, locale, platform, number = 1 } = Astro.props;
const dict = t(locale);
const slug = tutorial.data.slug;
const path = routes.tutorial(locale, platform.data.slug, slug);
const hrefFirst = lessons[0]
  ? routes.lesson(locale, platform.data.slug, slug, lessons[0].data.slug)
  : path;
const serializedSteps = JSON.stringify(lessons.map((lesson) => lesson.data.slug));
---

<article
  class="tutorial-card"
  data-progress-root
  data-tutorial-key={tutorialProgressKey(tutorial)}
  data-legacy-progress-key={tutorial.data.key}
  data-locale={locale}
  data-step-list={serializedSteps}
  data-step-url-base={path}
>
  <div class="tutorial-card__visual">
    <div class="tutorial-card__corner-number">{String(number).padStart(2, '0')}</div>
    {
      tutorial.data.visual === 'clock' ? (
        <div class="card-illustration" aria-hidden="true">
          <div class="card-illustration__clock">
            <span class="clock-hand clock-hand--one" />
            <span class="clock-hand clock-hand--two" />
            <span class="clock-dot" />
          </div>
          <div class="card-illustration__tick card-illustration__tick--first">
            <Icon name="check" size={17} />
          </div>
          <div class="card-illustration__tick card-illustration__tick--second">
            <Icon name="pause" size={15} />
          </div>
          <div class="card-illustration__spark" />
        </div>
      ) : (
        <div class="tutorial-artwork" aria-hidden="true">
          <span class="tutorial-artwork__ring" />
          <span class="tutorial-artwork__tile tutorial-artwork__tile--one">
            <Icon name="layers" size={31} />
          </span>
          <span class="tutorial-artwork__tile tutorial-artwork__tile--two">
            <Icon name="sparkles" size={26} />
          </span>
          <span class="tutorial-artwork__tile tutorial-artwork__tile--three">
            <Icon name="check" size={20} />
          </span>
        </div>
      )
    }
    <div class="tutorial-card__visual-footer">
      <span>{platform.data.title.toUpperCase()} / GUIDE</span>
      <span>{String(number).padStart(2, '0')} — {String(lessons.length).padStart(2, '0')}</span>
    </div>
  </div>
  <div class="tutorial-card__body">
    <div class="small-meta">
      <span>
        <Icon name="book-open" size={15} />
        {locale === 'es' ? 'GUÍA PRÁCTICA' : 'PRACTICAL GUIDE'}
      </span>
      <span>{tutorial.data.estimatedMinutes} {dict.minutes}</span>
    </div>
    <h3><a href={path}>{tutorial.data.title}</a></h3>
    <p>{tutorial.data.description}</p>
    <div class="tutorial-card__progress">
      <div class="tutorial-card__progress-track">
        <div data-progress-fill style="width: 0%"></div>
      </div>
      <span data-progress-count>0 / {lessons.length}</span>
    </div>
    <a
      class="tutorial-card__link"
      href={hrefFirst}
      data-continue-link
      data-continue-text={dict.continueLearning}
    >
      <span data-continue-label>{dict.startTutorial}</span>
      <span class="tutorial-card__link-icon"><Icon name="arrow-right" size={20} /></span>
    </a>
  </div>
</article>
