---
import type { Locale } from '../../config/locales';
import type { Lesson, Tutorial } from '../../lib/tutorials';
import { groupChapters } from '../../lib/tutorials';
import { routes } from '../../lib/routes';
import Icon from '../ui/Icon.astro';
interface Props {
  locale: Locale;
  tutorial: Tutorial;
  lessons: Lesson[];
}
const { locale, tutorial, lessons } = Astro.props;
const groups = groupChapters(lessons, locale);
const path = routes.tutorial(locale, tutorial.data.slug);
const steps = JSON.stringify(lessons.map((lesson) => lesson.data.slug));
---

<section
  class="learning-index"
  data-progress-root
  data-tutorial-key={tutorial.data.key}
  data-locale={locale}
  data-step-list={steps}
  data-step-url-base={path}
>
  <div class="learning-index__heading">
    <div>
      <span class="eyebrow eyebrow--ink"
        >{locale === 'es' ? 'TU RUTA DE APRENDIZAJE' : 'YOUR LEARNING ROADMAP'}</span
      ><h2>
        {
          locale === 'es'
            ? 'De la primera acción al último detalle.'
            : 'From the first click to the final detail.'
        }
      </h2>
    </div><div class="learning-index__counter">
      <strong data-progress-count>0 / {lessons.length}</strong><span
        >{locale === 'es' ? 'pasos aprendidos' : 'steps learned'}</span
      >
    </div>
  </div>
  <div class="learning-index__groups">
    {
      groups.map((group, groupIndex) => (
        <div class="learning-index__group">
          <div class="learning-index__group-label">
            <>
              <span>{String(groupIndex + 1).padStart(2, '0')}</span>
              <strong>{group.title}</strong>
            </>
          </div>
          <div class="learning-index__items">
            {group.lessons.map((lesson) => (
              <a
                class="learning-index__item"
                href={routes.lesson(locale, tutorial.data.slug, lesson.data.slug)}
                data-step-marker={lesson.data.slug}
              >
                <span class="learning-index__number">
                  {String(lesson.data.order).padStart(2, '0')}
                </span>
                <span class="learning-index__text">
                  <strong>{lesson.data.title}</strong>
                  <small>{lesson.data.description}</small>
                </span>
                <span class="learning-index__duration">{lesson.data.estimatedMinutes} min</span>
                <span class="learning-index__chevron">
                  <Icon name="arrow-right" size={18} />
                </span>
                <span class="learning-index__check">
                  <Icon name="check" size={16} />
                </span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
